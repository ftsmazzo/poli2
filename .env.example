# Nomes das variáveis de ambiente. Valores ficam no EasyPanel, nunca no repositório.

# Banco (Postgres com pgvector)
DATABASE_URL=

# Segurança do painel e dos segredos das Fontes
SESSION_SECRET=
ENCRYPTION_KEY=

# Evolution API (WhatsApp)
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_TOKEN=

# OpenRouter (orquestrador, redatora, Whisper e embeddings)
OPENROUTER_API_KEY=
OPENROUTER_ORCH_MODEL=
OPENROUTER_REDATORA_MODEL=
OPENROUTER_EMBED_MODEL=

# Mídia (volume do EasyPanel)
MEDIA_DIR=
